# Nginx reverse proxy for the availability scheduler.
#
# The Node process serves BOTH the SPA and the API on 127.0.0.1:4000, so this
# just terminates HTTPS and forwards everything to it.
#
# Steps to enable HTTPS once your domain points at the VPS:
#   1. Replace scheduler.example.com with your real domain below.
#   2. sudo apt install certbot python3-certbot-nginx
#   3. sudo certbot --nginx -d scheduler.example.com
#      (certbot rewrites this file to add the TLS certs + an HTTP->HTTPS redirect)

server {
    listen 80;
    server_name scheduler.example.com;

    location / {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}
