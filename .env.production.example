# Copy to .env.production (gitignored) and edit. The /deploy-production skill
# ships this to the VPS as the systemd service's EnvironmentFile.
#
# PORT and HOST are injected by the service unit, so don't set them here.

# Codes participants and the organizer use — CHANGE THESE before going public.
ACCESS_CODE=CHANGEME-PARTICIPANT
ADMIN_CODE=CHANGEME-ORGANIZER

# Display name of the event.
EVENT_TITLE=Reunión del equipo

# Hourly slot range (endHour exclusive): 7..23 => 07:00 .. 22:00
SLOT_START_HOUR=7
SLOT_END_HOUR=23
