# Global deploy config — copy to ~/.config/agent-deploy/config.env and edit.
# Written ONCE. Every project's /deploy-production reads these; no repo repeats them.

# How to reach the VPS. Prefer an alias defined in ~/.ssh/config (recommended),
# e.g. "myvps", so keys/user/host live in one place. A "user@host" also works.
VPS_SSH=myvps

# Apps are published at <project-name>.<BASE_DOMAIN> by default. A project can
# override with `domain = "..."` in its deploy.toml.
BASE_DOMAIN=apps.example.com

# Where app source is deployed on the VPS (one subdir per project).
REMOTE_ROOT=/opt/apps

# Directory the main Caddyfile imports per-app site files from.
# Your /etc/caddy/Caddyfile should contain:  import /etc/caddy/sites/*.caddy
CADDY_SITES_DIR=/etc/caddy/sites
