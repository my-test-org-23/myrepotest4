# Port the API listens on
PORT=4000

# Code participants type to sign in (then they set their name)
ACCESS_CODE=JULY2026

# Separate code that unlocks the read-only super-user dashboard
ADMIN_CODE=ADMIN2026

# Where the SQLite file lives (defaults to server/data/scheduler.db)
# DB_PATH=/var/lib/scheduler/scheduler.db

# Event display name
EVENT_TITLE=Reunión del equipo

# Hourly slot range (endHour is exclusive): 7..23 => 7:00 .. 22:00
SLOT_START_HOUR=7
SLOT_END_HOUR=23

# Allowed CORS origins ("*" for all, or comma-separated list). When the API
# also serves the built frontend (same origin) this can stay "*".
CORS_ORIGIN=*
